{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs');['package-lock.json','yarn.lock'].forEach(f=>fs.rmSync(f,{force:true}));if(!/^pnpm\\//.test(process.env.npm_config_user_agent||'')){console.error('Use pnpm instead');process.exit(1)}\"",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/veterinary-clinic run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present --filter \"!@workspace/mockup-sandbox\" run build",
    "test": "pnpm -r --if-present run test",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
